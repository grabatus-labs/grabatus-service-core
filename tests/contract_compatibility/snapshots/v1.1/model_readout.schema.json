{
  "$defs": {
    "ArtifactDescription": {
      "additionalProperties": false,
      "description": "One numeric artefact the service wrote, and its field dictionary.",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldDescription"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "format": {
          "enum": [
            "xlsx",
            "csv",
            "json",
            "parquet",
            "bigquery",
            "inline"
          ],
          "title": "Format",
          "type": "string"
        },
        "role": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        },
        "uri": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^(gs|bigquery|secret)://",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "role",
        "uri",
        "format",
        "description",
        "fields"
      ],
      "title": "ArtifactDescription",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "description": "A stated assumption, with the cost of it being wrong.",
      "properties": {
        "checked": {
          "title": "Checked",
          "type": "boolean"
        },
        "statement": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "violation_impact": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Violation Impact",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "violation_impact",
        "checked"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Caveat": {
      "additionalProperties": false,
      "description": "A limitation stated together with what not to conclude from it.\n\n``do_not_conclude`` is mandatory: a caveat without it is a disclaimer\nthat changes nobody's reading.",
      "properties": {
        "do_not_conclude": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Do Not Conclude",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "statement": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "statement",
        "do_not_conclude"
      ],
      "title": "Caveat",
      "type": "object"
    },
    "ComparisonBaseline": {
      "additionalProperties": false,
      "description": "What the finding is being compared against.",
      "properties": {
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "ComparisonBaseline",
      "type": "object"
    },
    "DataProvenance": {
      "additionalProperties": false,
      "description": "Shape and quality of the data behind the result.",
      "properties": {
        "entities": {
          "items": {
            "$ref": "#/$defs/EntitySummary"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Entities",
          "type": "array"
        },
        "filters_applied": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Filters Applied",
          "type": "array"
        },
        "granularity": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Granularity",
          "type": "string"
        },
        "known_gaps": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Known Gaps",
          "type": "array"
        },
        "observation_count": {
          "exclusiveMinimum": 0,
          "title": "Observation Count",
          "type": "integer"
        },
        "period_covered": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeriodCovered"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "quality_flags": {
          "default": [],
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 30,
          "title": "Quality Flags",
          "type": "array"
        }
      },
      "required": [
        "observation_count",
        "granularity",
        "entities"
      ],
      "title": "DataProvenance",
      "type": "object"
    },
    "Diagnostic": {
      "additionalProperties": false,
      "description": "One quality check, already judged against its threshold.",
      "properties": {
        "meaning": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "threshold": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Threshold",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "name",
        "value",
        "threshold",
        "status",
        "meaning"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "EntitySummary": {
      "additionalProperties": false,
      "description": "How many distinct things of a given kind were analysed.",
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "label": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "count"
      ],
      "title": "EntitySummary",
      "type": "object"
    },
    "ExplanationGuide": {
      "additionalProperties": false,
      "description": "Narration instructions for whichever LLM presents this result.",
      "properties": {
        "audience": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "guardrails": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 4,
          "title": "Guardrails",
          "type": "array"
        },
        "must_not_claim": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Must Not Claim",
          "type": "array"
        },
        "recommended_narrative_order": {
          "default": [],
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 20,
          "title": "Recommended Narrative Order",
          "type": "array"
        },
        "summary_for_llm": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Summary For Llm",
          "type": "string"
        },
        "what_was_solved": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "What Was Solved",
          "type": "string"
        }
      },
      "required": [
        "audience",
        "summary_for_llm",
        "what_was_solved",
        "must_not_claim",
        "guardrails"
      ],
      "title": "ExplanationGuide",
      "type": "object"
    },
    "FieldDescription": {
      "additionalProperties": false,
      "description": "One column of one artefact, in technical and plain terms.",
      "properties": {
        "interval_level": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval Level"
        },
        "meaning": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Meaning",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "read_as": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Read As",
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "integer",
            "string",
            "boolean",
            "date",
            "datetime"
          ],
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "type",
        "meaning",
        "read_as"
      ],
      "title": "FieldDescription",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "description": "One conclusion the service is willing to stand behind.",
      "properties": {
        "comparison_baseline": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonBaseline"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "enum": [
            "high",
            "moderate",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "confidence_rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Confidence Rationale",
          "type": "string"
        },
        "direction": {
          "enum": [
            "increase",
            "decrease",
            "stable",
            "not_applicable"
          ],
          "title": "Direction",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "importance": {
          "maximum": 100,
          "minimum": 1,
          "title": "Importance",
          "type": "integer"
        },
        "quantity": {
          "$ref": "#/$defs/Quantity"
        },
        "statement": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      },
      "required": [
        "id",
        "importance",
        "statement",
        "quantity",
        "uncertainty",
        "direction",
        "confidence",
        "confidence_rationale"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InputDigest": {
      "additionalProperties": false,
      "description": "Hash of one input, so the same run can be identified later.",
      "properties": {
        "role": {
          "maxLength": 32,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "sha256"
      ],
      "title": "InputDigest",
      "type": "object"
    },
    "InputRequirement": {
      "additionalProperties": false,
      "description": "One column the service reads, in business terms.",
      "properties": {
        "business_meaning": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Business Meaning",
          "type": "string"
        },
        "column": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "example": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Example",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "column",
        "required",
        "business_meaning",
        "example"
      ],
      "title": "InputRequirement",
      "type": "object"
    },
    "InterpretationRule": {
      "additionalProperties": false,
      "description": "Situation -> meaning -> recommendation. Turns a number into a decision.",
      "properties": {
        "observed_situation": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Observed Situation",
          "type": "string"
        },
        "what_it_means": {
          "maxLength": 500,
          "minLength": 1,
          "title": "What It Means",
          "type": "string"
        },
        "what_to_recommend": {
          "maxLength": 500,
          "minLength": 1,
          "title": "What To Recommend",
          "type": "string"
        }
      },
      "required": [
        "observed_situation",
        "what_it_means",
        "what_to_recommend"
      ],
      "title": "InterpretationRule",
      "type": "object"
    },
    "Misreading": {
      "additionalProperties": false,
      "description": "A wrong reading seen in the field, and its correction.",
      "properties": {
        "correction": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Correction",
          "type": "string"
        },
        "wrong_reading": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Wrong Reading",
          "type": "string"
        }
      },
      "required": [
        "wrong_reading",
        "correction"
      ],
      "title": "Misreading",
      "type": "object"
    },
    "ModelDescription": {
      "additionalProperties": false,
      "description": "What was fitted, under what assumptions, and what it cannot answer.",
      "properties": {
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Assumption"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Assumptions",
          "type": "array"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "family": {
          "enum": [
            "time_series_forecast",
            "bayesian_inference",
            "ab_test",
            "optimization",
            "classification",
            "regression",
            "clustering",
            "survival_analysis",
            "simulation",
            "association_rules"
          ],
          "title": "Family",
          "type": "string"
        },
        "formulation": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formulation"
        },
        "hyperparameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "maxProperties": 50,
          "propertyNames": {
            "maxLength": 120
          },
          "title": "Hyperparameters",
          "type": "object"
        },
        "not_designed_for": {
          "items": {
            "maxLength": 300,
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Not Designed For",
          "type": "array"
        },
        "objective": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "paradigm": {
          "enum": [
            "bayesian",
            "frequentist",
            "optimization",
            "heuristic",
            "ml_supervised",
            "ml_unsupervised"
          ],
          "title": "Paradigm",
          "type": "string"
        },
        "priors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Prior"
          },
          "maxItems": 30,
          "title": "Priors",
          "type": "array"
        }
      },
      "required": [
        "display_name",
        "family",
        "paradigm",
        "objective",
        "assumptions",
        "hyperparameters",
        "not_designed_for"
      ],
      "title": "ModelDescription",
      "type": "object"
    },
    "OverallQuality": {
      "additionalProperties": false,
      "description": "The single verdict on whether this result can be trusted.",
      "properties": {
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "status",
        "summary"
      ],
      "title": "OverallQuality",
      "type": "object"
    },
    "PeriodCovered": {
      "additionalProperties": false,
      "description": "Inclusive date range the observations span.",
      "properties": {
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PeriodCovered",
      "type": "object"
    },
    "Persona": {
      "additionalProperties": false,
      "description": "Who uses the service, and what hurts today.",
      "properties": {
        "pains": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Pains",
          "type": "array"
        },
        "role": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "pains"
      ],
      "title": "Persona",
      "type": "object"
    },
    "Prior": {
      "additionalProperties": false,
      "description": "A prior distribution and why it was chosen.",
      "properties": {
        "distribution": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Distribution",
          "type": "string"
        },
        "parameter": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Parameter",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "parameter",
        "distribution",
        "rationale"
      ],
      "title": "Prior",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "The number itself, with its unit.",
      "properties": {
        "unit": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "ReadoutRequest": {
      "additionalProperties": false,
      "description": "Which request produced this readout.",
      "properties": {
        "origin": {
          "enum": [
            "web",
            "api",
            "mcp",
            "internal"
          ],
          "title": "Origin",
          "type": "string"
        },
        "parameter_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Parameter Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "result_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "tenant_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9-]+$",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "result_id",
        "parameter_id",
        "tenant_id",
        "origin"
      ],
      "title": "ReadoutRequest",
      "type": "object"
    },
    "ReadoutService": {
      "additionalProperties": false,
      "description": "Which service, at which version, produced this readout.",
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ReadoutService",
      "type": "object"
    },
    "Reproducibility": {
      "additionalProperties": false,
      "description": "Seed, timing, input hashes and library versions.",
      "properties": {
        "compute_duration_seconds": {
          "minimum": 0.0,
          "title": "Compute Duration Seconds",
          "type": "number"
        },
        "input_digests": {
          "items": {
            "$ref": "#/$defs/InputDigest"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "library_versions": {
          "additionalProperties": {
            "maxLength": 64,
            "type": "string"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "propertyNames": {
            "maxLength": 120
          },
          "title": "Library Versions",
          "type": "object"
        },
        "random_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Random Seed"
        }
      },
      "required": [
        "compute_duration_seconds",
        "input_digests",
        "library_versions"
      ],
      "title": "Reproducibility",
      "type": "object"
    },
    "ServiceKnowledge": {
      "additionalProperties": false,
      "description": "Everything an LLM needs to know about the service itself.",
      "properties": {
        "common_misreadings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Misreading"
          },
          "maxItems": 30,
          "title": "Common Misreadings",
          "type": "array"
        },
        "glossary": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Glossary",
          "type": "array"
        },
        "input_requirements": {
          "items": {
            "$ref": "#/$defs/InputRequirement"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Input Requirements",
          "type": "array"
        },
        "interpretation_playbook": {
          "items": {
            "$ref": "#/$defs/InterpretationRule"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Interpretation Playbook",
          "type": "array"
        },
